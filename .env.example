# Familiarise Mobile Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# DATABASE
# ===========================================
# Primary: Flutter Prisma Connector (if available)
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Fallback: Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# AUTHENTICATION
# ===========================================
# BetterAuth (Primary)
BETTER_AUTH_URL=https://your-api.com/api/auth

# Google OAuth
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com

# Apple Sign In (configured in Xcode)

# ===========================================
# STREAM SDK (Video & Chat)
# ===========================================
STREAM_API_KEY=your-stream-api-key

# ===========================================
# PAYMENT GATEWAYS
# ===========================================
# Razorpay (Primary for India)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Stripe (International)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# ===========================================
# API
# ===========================================
# Backend API URL (Next.js web app)
API_BASE_URL=https://your-api.com

# ===========================================
# FIREBASE (Analytics, Crashlytics, Push)
# ===========================================
# Configured via google-services.json (Android) and GoogleService-Info.plist (iOS)

# ===========================================
# FEATURE FLAGS
# ===========================================
USE_PRISMA=false
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true

# ===========================================
# APP CONFIGURATION
# ===========================================
APP_NAME=Familiarise
APP_BUNDLE_ID=com.familiarise.mobile

# ============================================
# ADDED BY CLAUDE - Project Specific
# ============================================

# Environment files (contains secrets)
.env
.env.local
.env.*.local

# MCP Configuration
.mcp.json*
!.mcp.json.example

# Code Generation (rebuild with: dart run build_runner build)
*.g.dart
*.freezed.dart
*.gr.dart
*.config.dart
*.mocks.dart

# ============================================
# FLUTTER DEFAULT .gitignore (from flutter create)
# ============================================

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ============================================
# ADDED BY CLAUDE - Platform Build Files
# ============================================

# Android build files
/android/.gradle/
/android/local.properties
/android/app/src/main/gen/
*.jks
*.keystore
key.properties

# iOS build files
/ios/Pods/
/ios/Podfile.lock
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Flutter/flutter_export_environment.sh
/ios/ServiceDefinitions.json
/ios/Runner/GeneratedPluginRegistrant.*

# Web build
/web/favicon.png

# macOS build files
/macos/Flutter/ephemeral/
/macos/Flutter/GeneratedPluginRegistrant.swift
/macos/Pods/
/macos/Podfile.lock
/macos/.symlinks/

# Firebase (add actual files to repo if needed for CI)
google-services.json
GoogleService-Info.plist
firebase_options.dart

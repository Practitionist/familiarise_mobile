# Files and directories created by the Operating System
.DS_Store

# Files and directories created by pub
.dart_tool/
.packages
pubspec.lock

# Files and directories created by dart_frog
build/
.dart_frog

# Test related files
coverage/

# Environment files
.env

# ============================================
# Code Generation (regenerate with commands below)
# ============================================

# Prisma-generated type-safe code
# Regenerate: dart run bin/generate.dart --schema prisma/schema.prisma --output lib/generated
# (from prisma-flutter-connector directory)
lib/generated/

# Freezed/json_serializable generated files
# Regenerate: dart run build_runner build --delete-conflicting-outputs
*.freezed.dart
*.g.dart
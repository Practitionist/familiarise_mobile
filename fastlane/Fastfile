# Fastlane Fastfile for Familiarise Mobile
# Automates Android Play Store & iOS App Store / TestFlight releases alongside Shorebird OTA

default_platform(:android)

FLUTTER_VERSION = ENV.fetch("FLUTTER_VERSION", "3.47.6")
SHOREBIRD_FLAVOR = ENV.fetch("SHOREBIRD_FLAVOR", "prod")

# Shared helper to construct App Store Connect API Key when running in CI
def configure_asc_api_key
  return nil unless ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"] && ENV["APP_STORE_CONNECT_API_KEY"]

  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
    is_key_content_base64: ENV.fetch("APP_STORE_CONNECT_KEY_IS_BASE64", "false") == "true",
    in_house: false
  )
end

platform :android do
  desc "Build release AAB via Shorebird and upload to Google Play Internal Testing track"
  lane :internal do
    Dir.chdir("..") do
      sh("shorebird", "release", "android", "--flavor=#{SHOREBIRD_FLAVOR}", "--flutter-version=#{FLUTTER_VERSION}", "--", "--release")
    end
    aab_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
    upload_to_play_store(
      track: "internal",
      release_status: "completed",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build release AAB via Shorebird and upload to Google Play Closed Beta track"
  lane :beta do
    Dir.chdir("..") do
      sh("shorebird", "release", "android", "--flavor=#{SHOREBIRD_FLAVOR}", "--flutter-version=#{FLUTTER_VERSION}", "--", "--release")
    end
    aab_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
    upload_to_play_store(
      track: "beta",
      release_status: "completed",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build release AAB via Shorebird and upload to Google Play Production track"
  lane :production do
    Dir.chdir("..") do
      sh("shorebird", "release", "android", "--flavor=#{SHOREBIRD_FLAVOR}", "--flutter-version=#{FLUTTER_VERSION}", "--", "--release")
    end
    aab_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
    upload_to_play_store(
      track: "production",
      release_status: "completed",
      aab: aab_path,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deliver an instant 3-minute OTA Dart hotfix patch to Android via Shorebird"
  lane :patch do
    Dir.chdir("..") do
      sh("shorebird", "patch", "android", "--flavor=#{SHOREBIRD_FLAVOR}", "--release-version=latest")
    end
  end
end

platform :ios do
  desc "Sync signing certificates via match, build release IPA with Shorebird, and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = configure_asc_api_key

    match(
      type: "appstore",
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "com.familiarise.mobile"),
      readonly: true,
      api_key: api_key
    )

    Dir.chdir("..") do
      sh("shorebird", "release", "ios", "--flavor=#{SHOREBIRD_FLAVOR}", "--flutter-version=#{FLUTTER_VERSION}", "--", "--release", "--export-options-plist=ios/ExportOptions.plist")
    end

    ipa_path = File.expand_path(Dir.glob("../build/ios/ipa/*.ipa").first || UI.user_error!("No IPA found in build/ios/ipa/"), __dir__)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Sync signing certificates via match, build release IPA with Shorebird, and deliver to App Store Connect"
  lane :release do
    setup_ci if ENV["CI"]
    api_key = configure_asc_api_key

    match(
      type: "appstore",
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "com.familiarise.mobile"),
      readonly: true,
      api_key: api_key
    )

    Dir.chdir("..") do
      sh("shorebird", "release", "ios", "--flavor=#{SHOREBIRD_FLAVOR}", "--flutter-version=#{FLUTTER_VERSION}", "--", "--release", "--export-options-plist=ios/ExportOptions.plist")
    end

    ipa_path = File.expand_path(Dir.glob("../build/ios/ipa/*.ipa").first || UI.user_error!("No IPA found in build/ios/ipa/"), __dir__)

    deliver(
      api_key: api_key,
      ipa: ipa_path,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: true
    )
  end

  desc "Deliver an instant 3-minute OTA Dart hotfix patch to iOS via Shorebird"
  lane :patch do
    Dir.chdir("..") do
      sh("shorebird", "patch", "ios", "--flavor=#{SHOREBIRD_FLAVOR}", "--release-version=latest", "--no-codesign")
    end
  end
end
